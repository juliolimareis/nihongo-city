{
  "name": "nihongo-city",
  "version": "1.0.0",
  "description": "Jogo educativo para aprender japonês (PT-BR → JP) em Shibuya",
  "main": "dist/server/src/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/main.ts",
    "prestart": "npm run build:server",
    "start": "node dist/server/src/main.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsx server/src/cli/build.ts",
    "seed": "tsx server/src/cli/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "kuromoji": "^0.1.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
